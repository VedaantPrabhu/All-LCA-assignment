// swaping two numbers 
#include <stdio.h>

void swap(int *a, int *b)
{
    int temp;

    temp = *a;
    *a = *b;
    *b = temp;
}

int main()
{
    int a, b;

    printf("Enter the first number: ");
    scanf("%d", &a);

    printf("Enter the second number: ");
    scanf("%d", &b);

    printf("\nBefore Swapping:");
    printf("\nFirst number = %d", a);
    printf("\nSecond number = %d", b);

    swap(&a, &b);

    printf("\n\nAfter Swapping:");
    printf("\nFirst number = %d", a);
    printf("\nSecond number = %d", b);

    return 0;
}
