// WITHOUT RECURSSION


#include <stdio.h>

int main()
{
    int n, i;
    long long fact = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    if(n < 0 || n > 20)
    {
        printf("Invalid input");
    }
    else
    {
        for(i = 1; i <= n; i++)
        {
            fact = fact * i;
        }

        printf("Factorial = %lld", fact);
    }

    return 0;
}  







// # with recurssion


#include <stdio.h>

long long factorial(int n)
{
    if(n == 0 || n == 1)
    {
        return 1;
    }
    else
    {
        return n * factorial(n - 1);
    }
}

int main()
{
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    if(n < 0 || n > 20)
    {
        printf("Invalid input");
    }
    else
    {
        printf("Factorial = %lld", factorial(n));
    }

    return 0;
}


