
#include <stdio.h>

struct student
{
    int rollno;
    char name[50];
    int age;
    int marks[3];
    int total;
    float percentage;
};

int main()
{
    struct student s[100];
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    if(n < 1 || n > 100)
    {
        printf("Invalid input");
        return 0;
    }

    for(i = 0; i < n; i++)
    {
        printf("\nEnter student name: ");
        scanf("%s", s[i].name);

        printf("Enter age: ");
        scanf("%d", &s[i].age);

        printf("Enter roll number: ");
        scanf("%d", &s[i].rollno);

        s[i].total = 0;

        printf("Enter marks of 3 subjects:\n");

        for(int j = 0; j < 3; j++)
        {
            scanf("%d", &s[i].marks[j]);
            s[i].total = s[i].total + s[i].marks[j];
        }

        s[i].percentage = s[i].total / 3.0;
    }

    printf("\n----- STUDENT DETAILS -----\n");

    for(i = 0; i < n; i++)
    {
        printf("\nName: %s", s[i].name);
        printf("\nAge: %d", s[i].age);
        printf("\nRoll Number: %d", s[i].rollno);

        printf("\nTotal Marks: %d", s[i].total);
        printf("\nPercentage: %.2f%%\n", s[i].percentage);
    }

    return 0;
}

